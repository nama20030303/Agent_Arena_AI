# ============================================================
# Вселенная Знаний — конфигурация ИИ-провайдера
# Скопируй в backend/.env и подставь свои ключи:
#   cp backend/.env.example backend/.env
# Без ключей всё работает в автономном режиме (детерминированный Учитель).
# ============================================================

# Какой провайдер использовать: auto | openai | yandex | ollama | none
# auto = берёт первый настроенный (openai -> yandex -> ollama)
AI_PROVIDER=auto

# --- Вариант 1: OpenAI-совместимый API (OpenAI, DeepSeek, OpenRouter, LM Studio и т.д.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Вариант 2: YandexGPT
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt-lite

# --- Вариант 3: локальная модель через Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
